# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=

# Misc
NEXT_PUBLIC_SITE_URL=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Shop / Shiprocket (new) ──────────────────────────────────
# Leave blank to keep the Shiprocket integration disabled (it no-ops cleanly).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Self-defined shared secret — set the same value in the Shiprocket webhook config once an account exists.
SHIPROCKET_WEBHOOK_TOKEN=
# Flat shipping fee in paise, added to every shop order. Leave blank/0 for free shipping.
SHOP_FLAT_SHIPPING_FEE_PAISE=0
